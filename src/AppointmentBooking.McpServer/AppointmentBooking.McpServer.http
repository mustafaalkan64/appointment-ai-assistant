@AppointmentBooking.McpServer_HostAddress = http://localhost:5001

### 1. Health Check
GET {{AppointmentBooking.McpServer_HostAddress}}/health
Accept: application/json

###

### 2. MCP JSON-RPC: Initialize
POST {{AppointmentBooking.McpServer_HostAddress}}/mcp
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "method": "initialize",
  "params": null,
  "id": 1
}

###

### 3. MCP JSON-RPC: List Tools
POST {{AppointmentBooking.McpServer_HostAddress}}/mcp
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "method": "tools/list",
  "params": null,
  "id": 2
}

###

### 4. Ollama AI Chat & Function Calling (REST Endpoint)
POST {{AppointmentBooking.McpServer_HostAddress}}/mcp/chat
Content-Type: application/json

{
  "message": "Kadıköy Polikliniği için yarınki randevu saatlerini listeler misin?",
  "organizationId": "a0000000-0000-0000-0000-000000000001",
  "model": "qwen3.5:27b",
  "autoExecuteTools": true
}

###

### 5. Ollama AI Chat & Function Calling (JSON-RPC 2.0 Method)
POST {{AppointmentBooking.McpServer_HostAddress}}/mcp
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "method": "mcp/chat",
  "params": {
    "message": "Müsait randevularım var mı kontrol eder misin?",
    "organizationId": "a0000000-0000-0000-0000-000000000001",
    "customerId": "c0000000-0000-0000-0000-000000000001",
    "model": "qwen3.5:27b",
    "autoExecuteTools": true
  },
  "id": "chat-01"
}

###
